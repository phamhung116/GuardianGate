# GuardianGate local demo configuration. Never put real credentials in this file.

# Required: yes
# Sensitive: no
# Purpose: Next.js runtime mode.
# Safe default: development
NODE_ENV=development

# Required: yes
# Sensitive: yes (local-only demo credential)
# Purpose: PostgreSQL connection used by Prisma.
# Safe default: local Docker Compose demo database only.
DATABASE_URL=postgresql://guardiangate:guardiangate@localhost:5434/guardiangate?schema=public

# Required: no
# Sensitive: no
# Purpose: Prefer PostgreSQL persistence, or force the process-local fallback for a fast demo.
# Safe default: postgres (automatically falls back to memory if unavailable or unseeded).
GUARDIANGATE_STORE=postgres

# Required: no
# Sensitive: no
# Purpose: Allow only the committed fake personas to simulate TideCloak identity locally.
# Safe default: true outside production; set to off to require real TideCloak tokens.
GUARDIANGATE_DEMO_AUTH=true

# Required: yes
# Sensitive: no
# Purpose: Local TideCloak issuer base URL.
# Safe default: TideCloak Dev exposed by Docker Compose.
TIDECLOAK_URL=http://localhost:8080

# Required: yes
# Sensitive: no
# Purpose: TideCloak realm provisioned for GuardianGate.
# Safe default: provisioned local demo realm.
TIDECLOAK_REALM=guardiangate

# Required: yes
# Sensitive: no
# Purpose: TideCloak client ID registered for this Next.js application.
# Safe default: provisioned public PKCE client for the local demo.
TIDECLOAK_CLIENT_ID=guardiangate-web

# Required: yes
# Sensitive: no
# Purpose: Committed Forseti contract ID used for policy-governed operations.
# Safe default: none; generated by BE-005 after Forseti contract deployment.
TIDE_POLICY_CONTRACT_ID=
